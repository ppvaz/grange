# --- Agent Backends ---
# backend[:model], backend one of: claude, codex, agy, opencode.
# The CLI must be on PATH (shell aliases and functions aren't visible here).
# GRANGE_SMART=claude:claude-opus-5-5      # SMART_AGENTS roles (default backend: claude)
# GRANGE_CHEAP=claude:claude-sonnet-5-5    # Every other role (default backend: claude)
# GRANGE_SMART=codex:gpt-5.5
# GRANGE_CHEAP=agy:gemini-3.8-flash-high
# GRANGE_CHEAP=opencode:anthropic/claude-sonnet-5-5
# SMART_AGENTS=Oracle,Visionary
# One role on its own backend: GRANGE_AGENT_<ROLE>, ROLE one of
# EXECUTOR PLANNER GAP ORACLE VISIONARY DIGEST DISTILL
# GRANGE_AGENT_GAP=codex:gpt-5.5
# AGENT_TIMEOUT=600   ORACLE_TIMEOUT=1800   MAX_PENDING_TASKS=5

# --- Grow Mode ---
# GROW_MODE=auto             # "pair"=interactive (gates ON), "sleep"=autonomous (gates OFF), "auto"=custom config

# --- Agile Vibe Code Configuration ---
# ENABLE_CI=auto            # "auto"=run ci.sh if it exists, "true"=required, "false"=disabled
# ENABLE_APPROVAL_GATE=false # Require human approval (touch .plan-approved) before Executor runs
# ENABLE_REVIEW_GATE=false   # Pause Executor when Visionary raises concerns (touch .vision-reviewed to resume)
# ENABLE_TDD=true           # Executor writes tests first (TDD workflow)
# MAX_FILE_LINES=300        # Gap Finder flags files exceeding this line count
# REFACTOR_INTERVAL=5       # Commits between automatic refactoring signal checks
