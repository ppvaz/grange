# --- Agent Backends ---
# backend[:model][@effort], backend one of: claude, codex, agy, opencode.
# The CLI must be on PATH (shell aliases and functions aren't visible here).
# Leave out :model or @effort to use the CLI's own configured default.
# Check with: ./grow.sh status, or `grange agent check`.
#
# Suggested tiers (checked 2026-09-30; confirm with `codex debug models`,
# `agy models`, `opencode models`):
#   Claude Code  GRANGE_SMART=claude:claude-opus-5-5@high   GRANGE_CHEAP=claude:claude-sonnet-5-5
#   Codex        GRANGE_SMART=codex:gpt-6-astra@high        GRANGE_CHEAP=codex:gpt-6.1-sol@medium
#                (on a Plus plan: GRANGE_SMART=codex:gpt-6.1-sol@xhigh)
#   Antigravity  GRANGE_SMART=agy:gemini-3.8-flash-high     GRANGE_CHEAP=agy:gemini-3.8-flash-medium
#                (Gemini IDs already carry the effort; leave @effort off)
#   OpenCode     GRANGE_SMART=opencode:opencode/claude-opus-5-5   GRANGE_CHEAP=opencode:opencode/gpt-6.1-sol
#                (any provider/model you've logged into with `opencode auth login`)
#
# GRANGE_SMART=claude:claude-opus-5-5@high   # SMART_AGENTS roles (default backend: claude)
# GRANGE_CHEAP=claude:claude-sonnet-5-5      # Every other role (default backend: claude)
# SMART_AGENTS=Oracle,Visionary
# One role on its own backend: GRANGE_AGENT_<ROLE>, ROLE one of
# EXECUTOR PLANNER GAP ORACLE VISIONARY DIGEST DISTILL LENS SYNTHESIS
# GRANGE_AGENT_GAP=codex:gpt-6.1-sol@low
# AGENT_TIMEOUT=600   ORACLE_TIMEOUT=1800   REAP_JOB_TIMEOUT=1800   MAX_PENDING_TASKS=5

# --- Grow Mode ---
# GROW_MODE=auto             # "pair"=interactive (gates ON), "sleep"=autonomous (gates OFF), "auto"=custom config

# --- Agile Vibe Code Configuration ---
# ENABLE_CI=auto            # "auto"=run ci.sh if it exists, "true"=required, "false"=disabled
# ENABLE_APPROVAL_GATE=false # Require human approval (touch .plan-approved) before Executor runs
# ENABLE_REVIEW_GATE=false   # Pause Executor when Visionary raises concerns (touch .vision-reviewed to resume)
# ENABLE_TDD=true           # Executor writes tests first (TDD workflow)
# MAX_FILE_LINES=300        # Gap Finder flags files exceeding this line count
# REFACTOR_INTERVAL=5       # Commits between automatic refactoring signal checks
